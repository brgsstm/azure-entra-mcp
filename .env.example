# Local development. Copy to .env and fill in (values come from `terraform output`).
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_APP_CLIENT_ID=00000000-0000-0000-0000-000000000000
PUBLIC_BASE_URL=http://localhost:8000

# Local dev authenticates the server with a short-lived secret on the same app
# registration (see README "Running locally"). In Azure this is unset and the
# managed identity is used instead.
ENTRA_CLIENT_SECRET=

# Leave unset locally to use an in-memory token store and ephemeral keys.
# TOKEN_STORE_ACCOUNT=stmcpoauthxxxx
# JWT_SIGNING_KEY=
# STORAGE_ENCRYPTION_KEY=

LOG_LEVEL=INFO
